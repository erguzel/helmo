# --- 1. Python Internals ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 2. Modern Tooling (uv, ruff, mypy) ---
# uv: Ignore the virtual environment, but COMMIT uv.lock (for apps)
.venv/
.uv/
# If you are building a library, you might choose to ignore uv.lock, 
# but for applications, it is a MUST-COMMIT.

# Ruff / Linters
.ruff_cache/
.mypy_cache/
.pyre_configuration
.pytype/

# --- 3. Testing & Coverage ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
htmlcov/

# --- 4. Environment & Secrets ---
# Never commit credentials
.env
.env.*
.venv
pip-log.txt
pip-delete-this-directory.txt

# --- 5. IDEs & OS (Often better in Global Gitignore) ---
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- 6. Jupyter Notebooks ---
.ipynb_checkpoints